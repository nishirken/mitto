{
  "name": "mitto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/app-root.ts",
  "scripts": {
    "start": "vite",
    "build": "tsc --noEmit && vite build",
    "install:release": "adb install android/app/build/outputs/apk/release/app-release.apk",
    "build:apk:debug": "tsc --noEmit && vite build && cap sync android && cd android && ./gradlew assembleDebug",
    "build:apk:release": "tsc --noEmit && vite build && cap sync android && cd android && ./gradlew assembleRelease",
    "test": "vitest run",
    "lint": "tsc --noEmit && biome check src/",
    "format": "biome format --write src/",
    "clean": "rm -rf dist android/app/build && cd android && ./gradlew clean",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "src/**/*.{ts,css}": "biome check --write --no-errors-on-unmatched"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@lit-labs/signals": "^0.2.0",
    "@lit/context": "^1.1.6",
    "dexie": "^4.4.5",
    "lit": "^3.3.2",
    "mudita-ui": "github:nishirken/mudita-ui#d7d701460c57ad1950eb96c8d3db1986ecdcab94",
    "signal-polyfill": "^0.2.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@open-wc/testing": "^4.0.0",
    "@originjs/vite-plugin-commonjs": "^1.0.3",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.8.4",
    "lint-staged": "^16.4.0",
    "pino-pretty": "^13.1.3",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^7.0.2",
    "vite": "^8.0.1",
    "vitest": "^4.1.0"
  }
}
